# 복사해서 .env 로 쓰세요. .env 는 커밋되지 않습니다.

# AI 공급자: openai | anthropic. 비워 두면 OPENAI_API_KEY 가 있으면 openai.
# 키가 하나도 없으면 AI 두 곳(변수 담기·인사이트)이 규칙 기반 폴백으로 동작합니다.
VINUS_LLM_PROVIDER=

# OpenAI (Python 3.9 에서도 동작)
OPENAI_API_KEY=
VINUS_OPENAI_MODEL=gpt-5.4-mini

# Claude (Python 3.10+ 필요)
ANTHROPIC_API_KEY=
VINUS_LLM_MODEL=claude-opus-5-5

# 1 이면 키가 있어도 AI 를 끕니다 (시연 리허설용)
VINUS_AI_DISABLED=

# 프론트 주소 (쉼표로 여러 개)
VINUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
